{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:boundaries": "bunx --bun depcruise --config ../../.dependency-cruiser.cjs .",
    "e2e": "playwright test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@workspace/ui": "workspace:*",
    "better-auth": "1.7.6",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5"
  }
}
