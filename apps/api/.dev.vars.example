# Worker secrets for local dev. Copy to .dev.vars and fill in.
# Deployed values are set with: bunx wrangler secret put <NAME>

BETTER_AUTH_SECRET=
KEY_ENCRYPTION_SECRET=

# Operator-level YouTube Data API v3 key. Optional: without it, YouTube captures fall
# back to the operator transcript service, then to a partial item.
YOUTUBE_API_KEY=

# Operator-paid fallbacks (ADR-0006). Optional: without one, that fallback is skipped and the
# capture is saved partial. Each User may spend 2 lookups per service per UTC day.
TRANSCRIPT_API_KEY=
READER_API_KEY=

# Google sign-in (optional). Create a "Web application" OAuth client in Google Cloud Console
# with redirect URI <web origin>/api/auth/callback/google. Without both, Google sign-in is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
