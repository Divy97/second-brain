{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env run wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env run vitest run",
    "lint:boundaries": "bunx --bun depcruise --config ../../.dependency-cruiser.cjs ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@workspace/ai": "workspace:*",
    "@workspace/db": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.8",
    "@types/node": "^26.6.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.141.0"
  }
}
