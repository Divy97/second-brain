{
  "name": "@workspace/ai",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:boundaries": "bunx --bun depcruise --config ../../.dependency-cruiser.cjs ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": ["prettier --write", "eslint --fix --max-warnings 0 --no-warn-ignored"]
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
